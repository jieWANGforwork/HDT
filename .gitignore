# Keep lightweight release metadata under data/processed, but ignore generated
# replay buffers and heavy matrices.
data/processed/**/*.df
data/processed/**/*replay_buffer*.csv
data/processed/**/*.hdf
data/processed/**/embs_sims.npy
data/processed/**/adj_*.pkl
data/processed/**/checkpoint*

# Keep generated and full-size processed datasets on the research server. The
# public repository only carries the lightweight metadata needed to inspect
# configs and run installation checks.
data/processed/**/*.csv
data/processed/**/*.npy
data/processed/**/*.pkl
data/processed/**/*.hdf
data/processed/**/*.df

!data/processed/**/item_data.csv
!data/processed/**/pop_items.npy
!data/processed/**/less_items.npy
!data/processed/xing/train_data.csv
!data/processed/MANIFEST.md
